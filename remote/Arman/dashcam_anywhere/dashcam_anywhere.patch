diff -ruN orig/common/dashcam_anywhere.py new/common/dashcam_anywhere.py
--- orig/common/dashcam_anywhere.py	1969-12-31 19:00:00.000000000 -0500
+++ new/common/dashcam_anywhere.py	2026-10-03 15:13:40.945848696 -0400
@@ -0,0 +1,25 @@
+"""
+dashcam-anywhere: run this device as a pure dashcam on vehicles/robots without a car harness
+(no ignition signal, no CAN). It goes onroad whenever powered, never controls anything, and
+calibrates the camera from GPS / visual-odometry speed instead of CAN wheel speed.
+
+  touch /data/force_onroad    enable  (reboot to apply)
+  rm /data/force_onroad       disable (reboot to apply)
+  touch /data/reset_calib     restart camera calibration from scratch (consumed by calibrationd)
+
+Keep this module dependency-free and without import-time side effects: it is imported by
+manager-preimported daemons, the UI and tests.
+"""
+import os
+
+FLAG = "/data/force_onroad"
+RESET_CALIB_FLAG = "/data/reset_calib"
+CALIB_MARKER = "/data/calib_from_dashcam"  # CalibrationParams were learned in dashcam mode
+
+# Evaluated once: manager pre-imports every process module and forks the daemons from it,
+# so the whole system sees the value from manager start until the next reboot.
+ENABLED = os.path.isfile(FLAG)
+
+
+def enabled() -> bool:
+  return ENABLED
