+    flag.touch()
+    assert calibrationd.consume_reset_request(params)
+    assert not flag.exists()
+    assert params.get("CalibrationParams") is None
+
+  def test_reset_on_mode_change(self, monkeypatch, tmp_path):
+    marker = tmp_path / "calib_from_dashcam"
+    monkeypatch.setattr(dashcam_anywhere, "CALIB_MARKER", str(marker))
+    params = Params()
+    calib = messaging.new_message('liveCalibration').to_bytes()
+
+    # normal car without marker: untouched
+    monkeypatch.setattr(calibrationd, "DASHCAM", False)
+    params.put("CalibrationParams", calib, block=True)
+    calibrationd.reset_on_mode_change(params)
+    assert params.get("CalibrationParams") is not None
+
+    # entering dashcam mode drops the car's calibration
+    monkeypatch.setattr(calibrationd, "DASHCAM", True)
+    calibrationd.reset_on_mode_change(params)
+    assert params.get("CalibrationParams") is None and marker.exists()
+
+    # staying in dashcam mode keeps the dashcam calibration
+    params.put("CalibrationParams", calib, block=True)
+    calibrationd.reset_on_mode_change(params)
+    assert params.get("CalibrationParams") is not None
+
+    # leaving dashcam mode drops it again
+    monkeypatch.setattr(calibrationd, "DASHCAM", False)
+    calibrationd.reset_on_mode_change(params)
+    assert params.get("CalibrationParams") is None and not marker.exists()
